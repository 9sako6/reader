{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "types": ["chrome"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": ".build",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "types/**/*.d.ts",
    "packages/**/*.ts",
    "apps/chrome/src/**/*.ts",
    "apps/ios/ReaderExtension/Resources/viewer/**/*.ts"
  ]
}

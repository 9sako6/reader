{
  "name": "reader",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run compile && node scripts/build-chrome.js && node scripts/build-ios.js",
    "build:chrome": "pnpm run compile && node scripts/build-chrome.js",
    "build:ios": "pnpm run compile && node scripts/build-ios.js",
    "test": "pnpm run build && node --test",
    "check": "pnpm run typecheck"
  },
  "dependencies": {
    "defuddle": "0.19.2"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}

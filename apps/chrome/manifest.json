{
  "manifest_version": 3,
  "name": "reader",
  "version": "0.0.6",
  "description": "表示中または選択した文章を通常表示またはRSVPで読みやすくします。",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "action": {
    "default_title": "ページをreaderで読む"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["reader_session_bg.wasm"],
      "matches": ["<all_urls>"]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "RSVP Reader",
  "version": "0.2.0",
  "description": "Read selected Japanese text with a fixed-gaze RSVP overlay.",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "action": {
    "default_title": "ページ全体をRSVPで読む"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}

{
  "manifest_version": 3,
  "name": "reader",
  "version": "2026.9.0",
  "description": "閲覧中の文章を読みやすいreaderへ切り替えます。",
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bootstrap.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "defuddle.js",
        "runtime.js",
        "session-wasm.js",
        "reader_session_bg.wasm"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}

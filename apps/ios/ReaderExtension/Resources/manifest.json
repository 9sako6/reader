{
  "manifest_version": 3,
  "name": "reader",
  "version": "0.0.1",
  "description": "閲覧中の文章を読みやすいreaderへ切り替えます。",
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "defuddle.js",
        "engine.js",
        "extractor.js",
        "icons.js",
        "viewer.js",
        "bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
